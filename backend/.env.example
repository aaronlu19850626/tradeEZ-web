# MT5 ingest
TRADESYNC_SYNC_KEY=dev-sync-key-change-me
TRADESYNC_DB_PATH=data/tradesync.db
TRADESYNC_CORS_ORIGINS=*

# Email verification-code auth
# console: print code in backend terminal/data dev file (local development only)
# smtp: send real email
TRADESYNC_EMAIL_PROVIDER=console
TRADESYNC_AUTH_SECRET=replace-with-a-long-random-secret
TRADESYNC_CODE_TTL_SECONDS=600
TRADESYNC_CODE_COOLDOWN_SECONDS=60
TRADESYNC_CODE_MAX_PER_HOUR=5

# SMTP example for production:
# TRADESYNC_EMAIL_PROVIDER=smtp
# TRADESYNC_SMTP_HOST=smtp.example.com
# TRADESYNC_SMTP_PORT=587
# TRADESYNC_SMTP_USERNAME=apikey-or-user
# TRADESYNC_SMTP_PASSWORD=mail-password
# TRADESYNC_SMTP_FROM_EMAIL=no-reply@yourdomain.com
# TRADESYNC_SMTP_FROM_NAME=TradeSync
# TRADESYNC_SMTP_STARTTLS=true
# TRADESYNC_SMTP_SSL=false